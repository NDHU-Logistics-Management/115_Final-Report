# 113年6月至115年6月臺東縣市區客運圖表分析

library(data.table)

# 參數設定 ---------------------------------------------------------------

csv_path <- file.choose()
output_dir <- file.path(dirname(csv_path), "臺東縣市區客運_11306至11506_輸出")

start_date <- as.IDate("2024-06-01")
end_date <- as.IDate("2026-06-30")

ride_breaks <- c(0, 1, 5, 10, 20, 40, Inf)
ride_labels <- c("1次", "2–5次", "6–10次", "11–20次", "21–40次", "41次以上")

png_width <- 4800
png_height <- 2400
png_res <- 300

dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)

if (.Platform$OS.type == "windows") {
  windowsFonts(Kai = windowsFont("Microsoft JhengHei"))
  plot_family <- "Kai"
} else {
  plot_family <- "sans"
}

# 資料讀取與整理 ---------------------------------------------------------

needed_columns <- c(
  "業者編號", "卡號", "票種類型", "票種次類型",
  "搭乘路線代碼", "資料代表日期(yyyy-MM-dd)"
)

bus_data <- fread(
  csv_path,
  select = needed_columns,
  colClasses = "character",
  encoding = "UTF-8"
)

setnames(bus_data, "資料代表日期(yyyy-MM-dd)", "搭乘日期")
bus_data[, 搭乘日期 := as.IDate(搭乘日期)]

bus_data <- bus_data[
  !is.na(搭乘日期) &
    搭乘日期 >= start_date &
    搭乘日期 <= end_date &
    業者編號 == "1202" &
    !is.na(搭乘路線代碼) &
    grepl("^TTT", 搭乘路線代碼)
]

if (nrow(bus_data) == 0L) stop("指定期間內沒有符合條件的臺東市區客運資料。")

bus_data[, 年月 := format(搭乘日期, "%Y-%m")]
bus_data[, 是否TPASS := 票種類型 == "4" & 票種次類型 == "#TTT-299"]

month_starts <- seq(
  as.Date(format(as.Date(start_date), "%Y-%m-01")),
  as.Date(format(as.Date(end_date), "%Y-%m-01")),
  by = "month"
)

month_info <- data.table(
  年月 = format(month_starts, "%Y-%m"),
  月份標示 = sprintf(
    "%d/%02d",
    as.integer(format(month_starts, "%Y")) - 1911,
    as.integer(format(month_starts, "%m"))
  )
)

next_month_starts <- seq(
  month_starts[1],
  by = "month",
  length.out = length(month_starts) + 1L
)
month_info[, 當月日數 := as.integer(diff(next_month_starts))]

# 共用函數 ---------------------------------------------------------------

make_ylim <- function(y, ratio = 1.12) {
  ymax <- max(y, na.rm = TRUE)
  if (!is.finite(ymax) || ymax <= 0) return(c(0, 1))
  c(0, ymax * ratio)
}

save_png <- function(filename, plot_fun) {
  png(
    file.path(output_dir, filename),
    width = png_width,
    height = png_height,
    res = png_res,
    bg = "white"
  )
  on.exit(dev.off())
  plot_fun()
}

make_interval_table <- function(data) {
  passenger_month <- data[
    !is.na(卡號) & 卡號 != "",
    .(搭乘次數 = .N),
    by = .(年月, 卡號)
  ]

  passenger_month[, 搭乘次數區間 := cut(
    搭乘次數,
    breaks = ride_breaks,
    labels = ride_labels,
    include.lowest = TRUE,
    right = TRUE,
    ordered_result = TRUE
  )]

  interval_count <- passenger_month[
    , .(人數 = .N),
    by = .(年月, 搭乘次數區間)
  ]

  complete_grid <- CJ(
    年月 = month_info$年月,
    搭乘次數區間 = factor(ride_labels, levels = ride_labels, ordered = TRUE)
  )

  interval_count <- merge(
    complete_grid,
    interval_count,
    by = c("年月", "搭乘次數區間"),
    all.x = TRUE
  )
  interval_count[is.na(人數), 人數 := 0L]

  wide_table <- dcast(
    interval_count,
    年月 ~ 搭乘次數區間,
    value.var = "人數",
    fill = 0
  )

  wide_table <- merge(
    month_info[, .(年月, 月份標示)],
    wide_table,
    by = "年月",
    all.x = TRUE,
    sort = FALSE
  )

  setorder(wide_table, 年月)
  wide_table[, 年月 := NULL]
  setnames(wide_table, "月份標示", "年月")
  setcolorder(wide_table, c("年月", ride_labels))
  wide_table
}

plot_interval_lines <- function(wide_table, title_text) {
  y <- as.matrix(wide_table[, ..ride_labels])
  storage.mode(y) <- "numeric"

  n <- length(ride_labels)
  colors <- gray.colors(n, start = 0.15, end = 0.72)
  line_types <- seq_len(n)
  point_types <- 15:(14 + n)

  par(family = plot_family, mar = c(10, 8, 5, 13), xpd = FALSE)

  matplot(
    seq_len(nrow(wide_table)),
    y,
    type = "o",
    lty = line_types,
    lwd = 2,
    pch = point_types,
    cex = 1.1,
    col = colors,
    xaxt = "n",
    yaxt = "n",
    xlab = "",
    ylab = "",
    ylim = make_ylim(y),
    bty = "n",
    main = title_text,
    cex.main = 1.8
  )

  axis(
    1,
    at = seq_len(nrow(wide_table)),
    labels = wide_table$年月,
    las = 2,
    cex.axis = 0.9
  )
  axis(2, las = 1, cex.axis = 1.2)
  mtext("月份", side = 1, line = 7.2, cex = 1.7)
  mtext("人數", side = 2, line = 4.8, cex = 1.7)
  grid(col = "gray88", lty = "dotted")

  legend(
    "topright",
    inset = c(-0.13, 0),
    legend = ride_labels,
    col = colors,
    lty = line_types,
    lwd = 2,
    pch = point_types,
    bty = "n",
    xpd = TRUE,
    cex = 1.15,
    title = "每月搭乘次數"
  )
}

# 圖一：平均每日使用次數 -----------------------------------------------

daily_mean <- bus_data[, .(月使用次數 = .N), by = 年月]
daily_mean <- merge(month_info, daily_mean, by = "年月", all.x = TRUE, sort = FALSE)
daily_mean[is.na(月使用次數), 月使用次數 := 0L]
setorder(daily_mean, 年月)
daily_mean[, 日平均使用次數 := 月使用次數 / 當月日數]

daily_title <- "113年6月至115年6月臺東縣市區客運平均每日使用次數折線圖"

plot_daily_mean <- function() {
  y <- daily_mean$日平均使用次數
  x <- seq_len(nrow(daily_mean))

  par(family = plot_family, mar = c(10, 6, 5, 4))

  plot(
    x,
    y,
    type = "o",
    lwd = 2.5,
    pch = 16,
    cex = 1.2,
    col = "gray25",
    xaxt = "n",
    yaxt = "n",
    xlab = "",
    ylab = "平均每日使用次數",
    ylim = make_ylim(y, 1.18),
    bty = "n",
    main = daily_title,
    cex.lab = 1.7,
    cex.main = 1.8
  )

  axis(1, at = x, labels = daily_mean$月份標示, las = 2, cex.axis = 0.9)
  axis(2, las = 1, cex.axis = 1.2)
  mtext("月份", side = 1, line = 7.2, cex = 1.7)
  grid(col = "gray88", lty = "dotted")

  text(
    x,
    y,
    labels = format(round(y, 1), nsmall = 1),
    pos = 3,
    offset = 0.7,
    cex = 0.78
  )
}

save_png(paste0(daily_title, ".png"), plot_daily_mean)

# 圖二、表一：乘客個搭乘次數 ---------------------------------------------------

all_table <- make_interval_table(bus_data)
all_plot_title <- "113年6月至115年6月臺東縣市區客運乘客各搭乘次數區間月人數變化折線圖"
all_table_title <- "113年6月至115年6月臺東縣市區客運乘客各搭乘次數區間月人數變化表"

save_png(
  paste0(all_plot_title, ".png"),
  function() plot_interval_lines(all_table, all_plot_title)
)
fwrite(all_table, file.path(output_dir, paste0(all_table_title, ".csv")), bom = TRUE)

# 圖三、表二：TPASS乘客 --------------------------------------------------

tpass_table <- make_interval_table(bus_data[是否TPASS == TRUE])
tpass_plot_title <- "113年6月至115年6月臺東縣市區客運TPASS乘客各搭乘次數區間月人數變化折線圖"
tpass_table_title <- "113年6月至115年6月臺東縣市區客運TPASS乘客各搭乘次數區間月人數變化表"

save_png(
  paste0(tpass_plot_title, ".png"),
  function() plot_interval_lines(tpass_table, tpass_plot_title)
)
fwrite(tpass_table, file.path(output_dir, paste0(tpass_table_title, ".csv")), bom = TRUE)

cat("圖表已輸出至：", normalizePath(output_dir), "\n")

