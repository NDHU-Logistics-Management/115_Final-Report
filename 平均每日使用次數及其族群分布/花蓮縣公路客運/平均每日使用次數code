library(dplyr)
library(lubridate)
library(openxlsx)

data <- read.csv(
  "C:/Users/AVITA/Downloads/公路客運2024_to_202606.csv",
  fileEncoding = "UTF-8",
  stringsAsFactors = FALSE,
  check.names = FALSE
)

routes_hualien_THB <- c(
  "1121",
  "1122",
  "1123",
  "1125",
  "1126",
  "1128",
  "1129",
  "1130",
  "1132",
  "1133",
  "1135",
  "1136",
  "1137",
  "1139",
  "1140",
  "1141",
  "1142",
  "1143",
  "1145",
  "8119",
  "8161",
  "8173",
  "8181"
)

data$搭乘附屬路線名稱 <- trimws(
  as.character(
    data$搭乘附屬路線名稱
  )
)

data$`資料代表日期(yyyy-MM-dd)` <- as.Date(
  data$`資料代表日期(yyyy-MM-dd)`,
  format = "%Y-%m-%d"
)

matched_routes <- intersect(
  routes_hualien_THB,
  unique(data$搭乘附屬路線名稱)
)

cat(
  "成功對應的路線數：",
  length(matched_routes),
  "\n"
)

cat(
  "成功對應的路線：\n"
)

cat(
  matched_routes,
  sep = "\n"
)

missing_routes <- setdiff(
  routes_hualien_THB,
  unique(data$搭乘附屬路線名稱)
)

cat(
  "\n沒有對應到的路線：\n"
)

cat(
  missing_routes,
  sep = "\n"
)


data <- data %>%
  filter(
    !is.na(`資料代表日期(yyyy-MM-dd)`),

    `資料代表日期(yyyy-MM-dd)` >=
      as.Date("2024-06-01"),

    `資料代表日期(yyyy-MM-dd)` <=
      as.Date("2026-06-30"),

    搭乘附屬路線名稱 %in%
      routes_hualien_THB
  )

cat(
  "\n篩選後資料筆數：",
  nrow(data),
  "\n"
)

if (nrow(data) == 0) {

  stop(
    paste0(
      "篩選後沒有資料。",
      "請先執行 unique(data$搭乘附屬路線名稱)，",
      "確認該欄位是否真的使用1121、1122等名稱。"
    )
  )
}

actual_routes <- sort(
  unique(
    data$搭乘附屬路線名稱
  )
)

cat(
  "\n最後實際納入的路線數：",
  length(actual_routes),
  "\n"
)

cat(
  "最後實際納入的路線：\n"
)

cat(
  actual_routes,
  sep = "\n"
)

data <- data %>%
  mutate(

    Year =
      year(
        `資料代表日期(yyyy-MM-dd)`
      ),

    Month =
      month(
        `資料代表日期(yyyy-MM-dd)`
      )
  )

monthly_total <- data %>%
  group_by(
    Year,
    Month
  ) %>%
  summarise(

    該月總使用次數 = n(),

    .groups = "drop"
  )

monthly_people <- data %>%
  filter(
    !is.na(卡號),
    卡號 != ""
  ) %>%
  group_by(
    Year,
    Month
  ) %>%
  summarise(

    該月使用人數 =
      n_distinct(卡號),

    .groups = "drop"
  )


monthly_avg <- monthly_total %>%
  left_join(
    monthly_people,

    by = c(
      "Year",
      "Month"
    )
  )


monthly_avg <- monthly_avg %>%
  mutate(

    # 每個月第一天
    月初日期 = make_date(
      Year,
      Month,
      1
    ),

    該月天數 =
      days_in_month(
        月初日期
      ),

    每人每月使用次數 =
      該月總使用次數 /
      該月使用人數,

    平均每日使用次數 =
      每人每月使用次數 /
      該月天數
  ) %>%

  arrange(
    Year,
    Month
  )

monthly_avg <- monthly_avg %>%
  mutate(

    月份 = sprintf(
      "%03d%02d",
      Year - 1911,
      Month
    )
  )


print(
  monthly_avg
)


table_result <- monthly_avg %>%
  select(
    月份,
    該月總使用次數,
    該月使用人數,
    該月天數,
    每人每月使用次數,
    平均每日使用次數
  ) %>%

  rename(
    民國年月 = 月份
  ) %>%

  mutate(

    每人每月使用次數 =
      sprintf(
        "%.2f",
        每人每月使用次數
      ),

    平均每日使用次數 =
      sprintf(
        "%.3f",
        平均每日使用次數
      )
  )


print(
  table_result
)


write.xlsx(
  table_result,

  "C:/Users/AVITA/Downloads/113年6月至115年6月花蓮縣公路客運平均每日使用次數統計表.xlsx",

  rowNames = FALSE
)


plot_data <- monthly_avg %>%
  filter(
    !is.na(月份),
    !is.na(平均每日使用次數),
    is.finite(平均每日使用次數)
  ) %>%

  arrange(
    Year,
    Month
  )

month_label <-
  plot_data$月份

daily_avg <-
  plot_data$平均每日使用次數

x_pos <-
  seq_len(
    nrow(plot_data)
  )


cat(
  "\n月份數量：",
  length(month_label),
  "\n"
)

cat(
  "平均每日使用次數數量：",
  length(daily_avg),
  "\n"
)


y_min <- min(
  daily_avg,
  na.rm = TRUE
)

y_max <- max(
  daily_avg,
  na.rm = TRUE
)


y_axis_min <-
  floor(
    y_min / 0.01
  ) * 0.01


y_axis_max <-
  ceiling(
    y_max / 0.01
  ) * 0.01


ylim_lower <-
  y_axis_min - 0.01

ylim_upper <-
  y_axis_max + 0.01


y_breaks <- seq(
  from = y_axis_min,
  to = y_axis_max,
  by = 0.01
)


png(
  filename =
    "C:/Users/AVITA/Downloads/113年6月至115年6月花蓮縣公路客運平均每日使用次數折線圖.png",

  width = 12,
  height = 6,
  units = "in",
  res = 300
)

windowsFonts(
  kai =
    windowsFont(
      "Microsoft JhengHei"
    )
)


par(
  family = "kai",

  mar = c(
    6,
    8,
    5,
    10
  )
)

plot(
  x = 1:length(month_label),
  y = daily_avg,

  type = "o",
  pch = 16,
  lwd = 2,
  col = "black",
  xaxt = "n",
  yaxt = "n",
  bty = "n",

  xlab = "月份",
  ylab = "",
  ylim = c(
    ylim_lower,
    ylim_upper
  ),

  cex.lab = 1.3,
  cex.axis = 1.1
)
title(
  main =
    "113年6月至115年6月花蓮縣公路客運平均每日使用次數折線圖",
  adj = 0,
  cex.main = 1.6
)

mtext(
  "日均使用次數",
  side = 2,
  line = 5,
  cex = 1.3
)

x_index <- seq(
  1,
  length(month_label),
  by = 2
)

axis(
  1,
  at = x_index,
  labels = month_label[x_index],
  las = 1,
  cex.axis = 1
)


axis(
  1,
  at = 1:length(month_label),
  labels = FALSE,
  tcl = -0.3
)

axis(
  2,
  las = 1,
  cex.axis = 1.1
)


grid()

legend(
  x = length(month_label) * 1.03,
  y = max(daily_avg, na.rm = TRUE),

  legend = "日均使用次數",

  col = "black",
  lwd = 2,
  pch = 16,

  bty = "n",
  xpd = NA
)

dev.off()
