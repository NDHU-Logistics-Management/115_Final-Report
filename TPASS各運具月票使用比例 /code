library(dplyr)
library(tidyr)
library(data.table)
library(openxlsx)
library(tidyverse)

#--------------公路客運-------------- 
data0 <- fread("C:/Users/Angela/Documents/運籌期末/公路客運2024_to_202606.txt")
data0$搭乘路線名稱 <- trimws(as.character(data0$搭乘路線名稱))

hualien_routes <- c(
  "1121","1122","1125","1128","1129","1130","1132","1133",
  "1135","1136","1137","1139","1140","1141","1142","1143",
  "1145","8101","8102","8105","8119","8161","8173","8181"
) #花蓮公路客運

taitung_routes <- c(
  "8101","8102","8103","8105","8107","8109","8113","8115","8117",
  "8119","8120","8122","8125","8128","8129","8130","8131","8135",
  "8136","8137","8138","8150","8151","8152","8153","8157","8158",
  "8161","8163","8165","8166","8167","8168","8170","8171","8172",
  "8173","8178","8181"
) #台東公路客運


#------- 花蓮 --------
hualien <- data0[搭乘路線名稱 %in% hualien_routes ,]

hualien[, 月份 := sprintf(
  "%03d%02d",
  as.integer(format(`資料代表日期(yyyy-MM-dd)`, "%Y")) - 1911,
  as.integer(format(`資料代表日期(yyyy-MM-dd)`, "%m"))
)]

hualien <- hualien[
  月份 >= "11306" & 月份 <= "11506"
]

#TPASS
hua_tpass <- hualien[
  票種次類型 %in% c(
    "#HUA-199","#HUA-399","#TTT-299"
  )
]

hua_total <- hualien[
  ,
  .(總搭乘人次 = sum(原始票證筆數)),
  by = 月份
]
hua_tpass_total <-  hua_tpass[
  ,
  .(TPASS搭乘人次 = sum(原始票證筆數)),
  by = 月份
]

hua_total <- merge(
  hua_total,
  hua_tpass_total,
  by = "月份",
  all.x = TRUE
)
hua_total[, TPASS比例 := TPASS搭乘人次 / 總搭乘人次 * 100]
hua_total[, TPASS比例 := round(TPASS比例, 1)]
print(hua_total)

windowsFonts(msjh = windowsFont("Microsoft JhengHei"))

png("花蓮公路客運TPASS比例.png",
    width = 1800,
    height = 900,
    res = 300)

par(family = "msjh", mar = c(5, 5, 4, 2), bty = "l")

ymin <- floor(min(hua_total$TPASS比例)) - 1
ymax <- ceiling(max(hua_total$TPASS比例)) + 2

plot(
  1:nrow(hua_total),
  hua_total$TPASS比例,
  type = "o",
  pch = 16,
  lwd = 1,
  cex = 0.8,
  col = "grey35",
  xaxt = "n",
  yaxt = "n",
  xlab = "月份",
  ylab = "TPASS使用比例 (%)",
  main = "113年6月至115年6月花蓮縣公路客運TPASS使用比例折線圖",
  ylim = c(ymin,ymax)
)

axis(
  side = 1,
  at = 1:nrow(hua_total),
  labels = hua_total$月份,
  las = 2,
  cex.axis = 0.65
)

axis(
  side = 2,
  at = seq(ymin,ymax, by = 2),
  las = 1, 
  cex.axis = 0.65
)

text(
  x = 1:25,
  y = hua_total$TPASS比例,
  labels = paste0(hua_total$TPASS比例),
  pos = 3,
  offset = 0.35,
  cex = 0.5
)

dev.off()

